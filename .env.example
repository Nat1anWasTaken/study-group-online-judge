# Leaderboard-only by default. Set true to enable submission routes and workers.
JUDGE_ALLOW_CODE_SUBMISSIONS=false
# OJ origin contacted by the standalone leaderboard's Nginx proxy.
# Defaults to the API service on the Compose network; omit any path or trailing slash.
JUDGE_API_URL=http://api:8000
# Required only when submissions are enabled. Generate with openssl rand -hex 32.
JUDGE_API_TOKEN=
# Remote evaluator uses the latest default-branch version of this repository.
JUDGE_REPO_URL=https://github.com/cerulean-works/study-group-online-judge.git
JUDGE_SSH_HOST=
JUDGE_SSH_USER=
# Shared storage visible to the login node and GPU compute nodes.
JUDGE_REMOTE_WORK_ROOT=
JUDGE_SLURM_ACCOUNT=
JUDGE_SLURM_GPU_RESOURCE=gpu
# Generate auth key in the Tailscale admin console
TS_AUTHKEY=
TS_HOSTNAME=study-group-online-judge
JUDGE_WORK_ROOT=/var/lib/study-group-online-judge/work
DOCKER_GID=999

# Local CPU execution still uses this key. Leaderboards read Flock.
# GPU reports use JUDGE_REMOTE_WORK_ROOT/.netrc on the remote login node.
WANDB_API_KEY=
WANDB_ENTITY=cerulean-labs
WANDB_PROJECT=study-group-labs
WANDB_MODE=online

# Passed to the API container for leaderboard notifications and refreshes.
# For inline PNGs: bot token with files:write and destination channel ID.
JUDGE_SLACK_BOT_TOKEN=
JUDGE_SLACK_CHANNEL_ID=
JUDGE_SLACK_DAILY_TIME=19:00
JUDGE_SLACK_TIMEZONE=Asia/Taipei
JUDGE_LEADERBOARD_REFRESH_SECONDS=60

# Flock leaderboard reads (API key belongs to a member of this organization).
JUDGE_FLOCK_API_URL=
JUDGE_FLOCK_API_KEY=
# Dashboard origin; defaults to JUDGE_FLOCK_API_URL when empty.
JUDGE_FLOCK_WEB_URL=
JUDGE_FLOCK_ENTITY=cerulean-labs
JUDGE_FLOCK_LABS_PROJECT=study-group-labs
JUDGE_FLOCK_MIDTERM_PROJECT=midterm-nanogpt
